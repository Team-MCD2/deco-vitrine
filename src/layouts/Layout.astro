---
interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogImage?: string;
  canonicalPath?: string;
}

const {
  title = "Vente de Mobilier & Aménagement Immobilier à Toulouse | DecoShop",
  description = "DecoShop Toulouse : votre magasin de mobilier pour l'immobilier. Tables, lits, canapés et décoration au 60 rue Jacques Babinet. Home staging et aménagement. Demandez votre devis !",
  keywords = "Magasin meubles Toulouse, Lits Toulouse, Tables Toulouse, Aménagement intérieur immobilier, Home staging Toulouse, DecoShop Toulouse, Décoration Toulouse",
  ogTitle = "Vente de Mobilier & Aménagement Immobilier à Toulouse | DecoShop",
  ogDescription = "Expert en ameublement et valorisation immobilière à Toulouse. Tables, lits, décoration... Visitez notre showroom au 60 rue Jacques Babinet.",
  ogType = "website",
  ogImage = "https://deco-vitrine.vercel.app/images/hero-showroom.png",
  canonicalPath = "",
} = Astro.props;

const canonicalUrl = `https://deco-vitrine.vercel.app${canonicalPath}`;
---
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favico.png" />
    <link rel="apple-touch-icon" href="/favico.png" />
    
    <!-- SEO Meta & Geo Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="DecoShop" />
    <link rel="canonical" href={canonicalUrl} />
    
    <meta name="geo.region" content="FR-31">
    <meta name="geo.placename" content="Toulouse">
    <meta name="geo.position" content="43.5786;1.4014">
    <meta name="ICBM" content="43.5786, 1.4014">
    
    <!-- Open Graph / Social Media -->
    <meta property="og:type" content={ogType}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:title" content={ogTitle}>
    <meta property="og:description" content={ogDescription}>
    <meta property="og:image" content={ogImage}>
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:title" content={ogTitle}>
    <meta property="twitter:description" content={ogDescription}>
    <meta property="twitter:image" content={ogImage}>

    <!-- Schema.org LocalBusiness -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": ["LocalBusiness", "FurnitureStore", "RealEstateAgent"],
      "name": "DecoShop Toulouse",
      "image": "https://www.decoshop-toulouse.fr/logo-decoshop.png",
      "@id": "https://www.decoshop-toulouse.fr/",
      "url": "https://www.decoshop-toulouse.fr/",
      "telephone": "+33767278625",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 rue Jacques Babinet",
        "addressLocality": "Toulouse",
        "postalCode": "31100",
        "addressCountry": "FR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 43.5786,
        "longitude": 1.4014
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
        "opens": "09:30",
        "closes": "19:30"
      },
      "sameAs": [
        "https://www.tiktok.com/@decoshoptoulouse"
      ]
    }
    </script>

    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Custom CSS & Scripts -->
    <link rel="stylesheet" href="/styles.css?v=4.1">
</head>
<body>
<header>
        <div class="nav-container">
            <a href="/" class="logo-text">
                <span class="logo-main">DECOSHOP</span>
                <span class="logo-sub">Mobilier design et tendance</span>
            </a>
            <ul class="nav-links">
                <li><a href="/">Accueil</a></li>
                <li><a href="/concept">Le Concept</a></li>
                <li><a href="/collections">Collections</a></li>
                <li><a href="/tiktok">Vidéos</a></li>
                <li><a href="/contact">Contact</a></li>
                <li class="mobile-only"><a href="/contact" class="cta-button" style="display:inline-block; margin-top:1rem;">Visiter le Magasin</a></li>
            </ul>
            <a href="/contact" class="cta-button desktop-only">Visiter le Magasin</a>
            <div class="burger">
                <div class="line1"></div>
                <div class="line2"></div>
                <div class="line3"></div>
            </div>
        </div>
    </header>
<main>
    <slot />
</main>
<footer>
        <div class="footer-top">
            <div class="footer-grid">
                <div class="footer-col-1">
                    <a href="index" class="logo-text" style="margin-bottom: 1.5rem;">
                        <span class="logo-main">DECOSHOP</span>
                        <span class="logo-sub">Mobilier design et tendance</span>
                    </a>
                    <p>Votre magasin spécialiste en mobilier et aménagement d'intérieur pour l'immobilier sur Toulouse.</p>
                    <div class="social-links">
                        <a href="https://www.tiktok.com/@decoshoptoulouse" target="_blank" aria-label="TikTok"><i class="fab fa-tiktok"></i></a>
                        <a href="/" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="/" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                    </div>
                </div>

                <div class="footer-col-2">
                    <p class="footer-heading">Navigation</p>
                    <ul class="footer-list">
                        <li><a href="/">Accueil</a></li>
                        <li><a href="/concept">Le Concept</a></li>
                        <li><a href="/collections">Nos Collections</a></li>
                        <li><a href="/#faq">FAQ</a></li>
                    </ul>
                </div>

                <div class="footer-col-3">
                    <p class="footer-heading">Le Magasin</p>
                    <ul class="footer-list">
                        <li><p>60 rue Jacques Babinet<br>31100 Toulouse</p></li>
                        <li><a href="tel:+33767278625">07 67 27 86 25</a></li>
                        <li><a href="mailto:contact@decoshop-toulouse.fr">contact@decoshop-toulouse.fr</a></li>
                    </ul>
                </div>

                <div class="footer-col-4">
                    <p class="footer-heading">Horaires</p>
                    <ul class="footer-list">
                        <li>
                            <span style="display: block; color: #FFF;">Lundi - Dimanche</span>
                            <span>09h30 - 19h30</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="footer-middle">
            <div class="footer-middle-content">
                <p>&copy; 2026 DECOSHOP TOULOUSE — Tous droits réservés.</p>
                <div class="legal-links">
                    <a href="/mentions-legales">Mentions légales</a>
                    <a href="/mentions-legales#confidentialite">Confidentialité</a>
                    <a href="/mentions-legales#cookies">Cookies</a>
                </div>
            </div>
        </div>

        <!-- Signature agence -->
        <div class="footer-bottom">
            <div class="footer-bottom-content">
                <span>Développée par</span>
                <a href="https://microdidact.com/" target="_blank" rel="noopener" aria-label="Microdidact - Agence Web">
                    Microdidact
                    <svg style="width: 12px; height: 12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M7 17L17 7M8 7h9v9"/>
                    </svg>
                </a>
            </div>
        </div>
    </footer>
<script is:inline src="/script.js?v=4.1"></script>
</body>
</html>
